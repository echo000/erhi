#version 460
#extension GL_EXT_ray_tracing : require

// What `triangles_pipeline.slang` is, in GLSL: a module a stage, each with
// the one entry point `main`.
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;

layout(set = 0, binding = 1, rgba8) uniform image2D target;

layout(location = 0) rayPayloadEXT vec4 colour;

void main() {
    vec2 at = (vec2(gl_LaunchIDEXT.xy) + 0.5) / 16.0 * 2.0 - 1.0;
    colour = vec4(0.0);
    traceRayEXT(
        scene,
        gl_RayFlagsNoneEXT,
        0xff,
        0,
        0,
        0,
        vec3(at, -1.0),
        0.0,
        vec3(0.0, 0.0, 1.0),
        10.0,
        0
    );
    imageStore(target, ivec2(gl_LaunchIDEXT.xy), colour);
}
